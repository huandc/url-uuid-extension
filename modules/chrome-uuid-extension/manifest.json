{
  "manifest_version": 3,
  "name": "URL UUID 工具",
  "version": "1.2.0",
  "description": "获取当前页面 URL 中的 UUID，并支持替换后刷新页面",
  "permissions": ["activeTab", "tabs", "clipboardWrite", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "URL UUID 工具"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
